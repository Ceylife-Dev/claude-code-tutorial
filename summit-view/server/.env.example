# Copy this file to .env and fill in your values.

# Port the API listens on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas).
# Leave blank to store quote requests in server/data/quotes.json instead (handy for local testing).
MONGODB_URI=

# Secret token required to list quote requests: GET /api/quotes with header "x-admin-token: <token>"
ADMIN_TOKEN=change-me-to-a-long-random-string

# Allowed browser origin for the API in production (your live domain)
CLIENT_ORIGIN=http://localhost:5173
